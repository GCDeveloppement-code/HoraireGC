# Base de données PostgreSQL
DATABASE_URL="postgresql://hsgc:hsgc@localhost:5432/heures_sup?schema=public"

# Secret de signature des sessions (32 caractères minimum, ex. `openssl rand -base64 32`)
AUTH_SECRET="change-moi-avec-une-longue-chaine-aleatoire"

# URL publique de l'appli (utilisée par la PWA et les liens)
APP_URL="http://localhost:3000"
# en prod : APP_URL="https://horaire.gcdeveloppement.fr"

# Mot de passe provisoire donné aux comptes créés par le seed (à changer à la première connexion)
SEED_PASSWORD="gc-2026"
